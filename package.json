{
  "name": "docnear",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@docnear/api --filter=@docnear/web",
    "dev:api": "turbo dev --filter=@docnear/api",
    "dev:web": "turbo dev --filter=@docnear/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "db:studio": "turbo db:studio --filter=@docnear/api",
    "db:migrate": "turbo db:migrate --filter=@docnear/api",
    "db:seed": "turbo db:seed --filter=@docnear/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "turbo": "^2.1.3",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.5.0"
}
