# ─── Copy this file to .env and fill in real values ──────────────────────────
# NEVER commit .env — it is gitignored

NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local:    postgresql://docnear:docnear_dev_password@localhost:5432/docnear_db
# Railway:  copy from Railway PostgreSQL service → Connect → Public URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local:    redis://:docnear_redis_dev@localhost:6379
# Railway:  copy from Railway Redis service → Connect → Public URL
REDIS_URL=redis://:PASSWORD@HOST:PORT

# ─── JWT (generate with: openssl rand -hex 32) ────────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption key (run: openssl rand -hex 32) ───────────────────────────────
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# ─── S3 / MinIO ───────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=docnear_minio_user
S3_SECRET_KEY=your_minio_password
S3_BUCKET=docnear
S3_REGION=ap-south-1

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── MSG91 SMS (optional — stubbed if empty) ──────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DOCNEAR
MSG91_OTP_TEMPLATE_ID=

# ─── SendGrid Email (optional — stubbed if empty) ─────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@docnear.in

# ─── Firebase FCM ─────────────────────────────────────────────────────────────
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=firebase-adminsdk-XXXX@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# ─── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Super Admin (created by seed script) ─────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=StrongPassword123!

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
