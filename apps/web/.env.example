# ─── DocNear Web — env vars ───────────────────────────────────────────────────
# Copy to .env.local for local dev. Set in Railway Variables for production.

# Public API URL — must be the full URL including /v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# For production (Railway), use the @docnear/api service public URL:
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/v1

# Canonical URL of this web app (for OG tags / sitemaps)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay publishable key (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_Ss2iS3PWZX52Cg

# Optional: WebSocket URL (defaults to same origin as API)
NEXT_PUBLIC_WS_URL=http://localhost:4000
