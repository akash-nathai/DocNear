# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://docnear:docnear_dev@localhost:5432/docnear_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (generate with: openssl genrsa -out private.pem 2048) ────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption (AES-256-CBC — 32 random bytes as hex) ────────────────────────
ENCRYPTION_KEY=change_me_64_hex_chars_for_aes256_key_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=docnear_meili_dev_key

# ─── MinIO / S3 ───────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=docnear
S3_REGION=ap-south-1

# ─── Razorpay (stub — use test keys) ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ─── MSG91 (stub) ─────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=placeholder
MSG91_SENDER_ID=DOCNEAR
MSG91_OTP_TEMPLATE_ID=placeholder

# ─── SendGrid (stub) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.placeholder
SENDGRID_FROM_EMAIL=noreply@docnear.in

# ─── Firebase FCM (stub) ──────────────────────────────────────────────────────
FCM_PROJECT_ID=placeholder
FCM_CLIENT_EMAIL=placeholder@project.iam.gserviceaccount.com
FCM_PRIVATE_KEY=placeholder

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Super Admin seed (used by prisma/seed/admin.seed.ts) ────────────────────
SUPER_ADMIN_EMAIL=admin@docnear.in
SUPER_ADMIN_PASSWORD=change_me_strong_password

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
