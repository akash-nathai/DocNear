{
  "extends": "@docnear/config/tsconfig/nest.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "paths": {
      "@/*": ["src/*"],
      "@docnear/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@docnear/shared-types/*": ["../../packages/shared-types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
